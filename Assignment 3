lenght3 = float(input("Enter third lenght of the triangle:"))


if lenght1 >= lenght2 and lenght1 >= lenght3:
    largest = lenght1
    side1 = lenght2
    side2 = lenght3
elif lenght2 >= lenght1 and lenght2 >= lenght3:
